# Copy to .env and fill in. .env is gitignored — it holds every secret.
# Generate random values with: openssl rand -hex 32

# --- PostgreSQL (docker-compose.yml creates the database with these) ---------
# Use letters/digits only (e.g. `openssl rand -hex 16`) — it goes into a URL.
POSTGRES_USER=yo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yo

# --- Local development only (`npm run dev` on your machine) -----------------
# In Docker the app builds its own DATABASE_URI from the POSTGRES_* values above.
DATABASE_URI=postgres://yo:change-me@localhost:5433/yo

# --- App ---------------------------------------------------------------------
# Signs admin sessions; 32+ characters, the production server refuses to start without it.
PAYLOAD_SECRET=
# Public origin (canonical URLs, sitemap, JSON-LD). Baked in at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain Caddy serves and gets an HTTPS certificate for (production only).
DOMAIN=example.com

# --- Contact form → email (SMTP) --------------------------------------------
# Submissions are mailed to CONTACT_FORM_TO. Without SMTP_HOST outside
# production the message is only logged to the console.
CONTACT_FORM_TO=info@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; many providers require it to match SMTP_USER.
SMTP_FROM="Йо! <no-reply@example.com>"

# --- Optional ------------------------------------------------------------------
# Used only by `npm run seed` (demo content + first admin) — not needed in production.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# Vercel Blob token for uploads; unset = uploads go to the media volume.
# BLOB_READ_WRITE_TOKEN=
