# Copy to .env. Matches docker-compose.yml.
DATABASE_URI=postgres://yo:yo@localhost:5433/yo
# Any long random string, e.g. `openssl rand -hex 32`. Signs admin sessions.
PAYLOAD_SECRET=change-me
# Public origin of the site (canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form → email (SMTP). The form mails submissions to CONTACT_FORM_TO.
# Without SMTP_HOST (outside production) the message is only logged to the console.
CONTACT_FORM_TO=info@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; many providers require it to match SMTP_USER.
SMTP_FROM="Йо! <no-reply@example.com>"
